DOCTYPE html>
<html lang="pt-BR">
<head> 
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Jonatas Daniel</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f2f2f2;
      color: #222;
      text-align: center;
    }

    header {
      background: #111;
      color: white;
      padding: 25px 10px;
    }

    header h1 {
      margin: 0;
      font-size: 30px;
    }

    header p {
      margin: 10px 0 0;
    }

    .botoes {
      margin: 20px 10px;
    }

    button {
      background: #111;
      color: white;
      border: none;
      padding: 12px 20px;
      margin: 5px;
      border-radius: 8px;
      font-size: 16px;
    }

    .produtos {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 15px;
      padding: 15px;
    }

    .produto {
      background: white;
      width: 280px;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 2px 8px #ccc;
    }

    .produto h2 {
      margin-top: 0;
    }

    .preco {
      font-size: 24px;
      font-weight: bold;
      margin: 15px;
    }
  </style>
</head>

<body>

  <header>
    <h1>Jonatas Daniel</h1>
    <p>Produtos, ofertas e novidades</p>
  </header>

  <div class="botoes">
    <button>Produtos</button>
    <button>Ofertas</button>
  </div>

  <h2>Produtos</h2>

  <div class="produtos">

    <div class="produto">
      <h2>Celular</h2>
      <p>Smartphone moderno</p>
      <div class="preco">R$ 999,90</div>
      <button>Comprar</button>
    </div>

    <div class="produto">
      <h2>Fone</h2>
      <p>Fone de ouvido</p>
      <div class="preco">R$ 99,90</div>
      <button>Comprar</button>
    </div>

    <div class="produto">
      <h2>Computador</h2>
      <p>Computador completo</p>
      <div class="preco">R$ 1.999,90</div>
      <button>Comprar</button>
    </div>

  </div>

</body>
</html>
